<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{APP_NAME}} 採点ダッシュボード · 第{{ATTEMPT}}回</title>
<link rel="stylesheet" href="scoring.css">
</head>
<body class="dashboard">

<!-- ════════════ HEADER ════════════ -->
<div class="dash-header">
  <div class="dash-header-top">
    <span class="app-badge">{{APP_NAME}}</span>
    <span class="attempt-badge">第{{ATTEMPT}}回</span>
  </div>
  <h1>{{APP_NAME}} 採点ダッシュボード</h1>
  <p class="subtitle">ISO/IEC/IEEE 29148:2018 準拠 5軸ルーブリック · {{GENERATED_AT}} · {{CHECK_COUNT}}チェック</p>
</div>

<div class="dash-container">

<!-- ════════════ HERO (score + scale + summary) ════════════ -->
<section class="dash-hero">
  <div class="dash-hero-score">
    <div class="label">合計スコア</div>
    <div class="value">
      <span class="num">{{TOTAL}}</span>
      <span class="den">/ 100</span>
    </div>
    <div class="scale">
      <div class="scale-bar">
        <div class="scale-fill {{SCORE_LEVEL}}" style="width:{{TOTAL}}%"></div>
        <div class="scale-threshold" title="合格ライン 80"></div>
      </div>
      <div class="scale-ticks">
        <span>0</span>
        <span class="t-mid">合格ライン 80</span>
        <span>100</span>
      </div>
    </div>
  </div>
  <div class="dash-hero-summary">
    <div class="pill-row">{{PASS_FAIL_BADGE}}</div>
    <dl>
      <div>
        <dt>不備件数</dt>
        <dd>{{DEFICIENCY_COUNT}}</dd>
      </div>
      <div>
        <dt>AI 改善可能</dt>
        <dd>{{AI_IMPROVABLE_COUNT}}</dd>
      </div>
      <div>
        <dt>人間対応必要</dt>
        <dd>{{HUMAN_REQUIRED_COUNT}}</dd>
      </div>
    </dl>
  </div>
</section>

<!-- ════════════ AXIS BAR CHART ════════════ -->
<div class="card">
  <div class="card-header">
    <h2>軸別スコア</h2>
    <span class="info">各軸 20点満点 / 赤破線 = 軸別最低点 (12点)</span>
  </div>
  <div class="card-body" style="position:relative">
    {{AXIS_BAR_ROWS}}
  </div>
</div>

<!-- ════════════ CHECK VERDICT GRID ════════════ -->
<div class="card">
  <div class="card-header">
    <h2>チェック判定グリッド</h2>
    <span class="info">5 = 合格 / 2 = 部分 / 0 = 不合格 · {{CHECK_COUNT}}チェック</span>
  </div>
  <div class="card-body" style="overflow-x:auto">
    <table class="verdict-table">
      <thead>
        <tr>
          <th>軸</th>
          <th class="score-col">スコア</th>
          <th>C1</th>
          <th>C2</th>
          <th>C3</th>
          <th>C4</th>
        </tr>
      </thead>
      <tbody>
        {{CHECK_GRID_ROWS}}
      </tbody>
    </table>
  </div>
</div>

<!-- ════════════ DEFICIENCY TABLE ════════════ -->
<div class="card">
  <div class="card-header">
    <h2>不備一覧</h2>
    <span class="info">{{DEFICIENCY_COUNT}}件 — 重要度順</span>
  </div>
  <div class="card-body" style="padding:0;overflow-x:auto">
    <table class="def-table">
      <thead>
        <tr>
          <th style="width:110px">重要度</th>
          <th style="width:100px">軸</th>
          <th style="width:64px">チェック</th>
          <th style="width:150px">ドキュメント</th>
          <th>問題</th>
          <th style="width:120px">タグ</th>
        </tr>
      </thead>
      <tbody>
        {{DEFICIENCY_ROWS}}
      </tbody>
    </table>
  </div>
</div>

<!-- ════════════ PROJECTION ════════════ -->
<div class="card">
  <div class="card-header">
    <h2>改善シミュレーション</h2>
    <span class="info">Deficiency 解消時の予測スコア</span>
  </div>
  <div class="card-body">
    <div class="sim-grid">
      <div class="sim-card sim-current">
        <div class="sim-label">現在</div>
        <div class="sim-val">{{TOTAL}}</div>
      </div>
      <div class="sim-card sim-ai">
        <div class="sim-label">AI {{AI_IMPROVABLE_COUNT}} 件解消</div>
        <div class="sim-val">{{PROJECTED_AI_ONLY}}</div>
      </div>
      <div class="sim-card sim-full">
        <div class="sim-label">+ 人間 {{HUMAN_REQUIRED_COUNT}} 件解消</div>
        <div class="sim-val">{{PROJECTED_FULL}}</div>
      </div>
      <div class="sim-card sim-threshold">
        <div class="sim-label">合格閾値</div>
        <div class="sim-val">80</div>
      </div>
    </div>
    <p class="sim-note">{{SIM_NOTE}}</p>
    <div class="gap-counts">
      <div class="gap-count-item gc-ai">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M5 8.5L7 10.5L11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        AI改善可能: {{AI_IMPROVABLE_COUNT}}件
      </div>
      <div class="gap-count-item gc-human">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 5V8.5M8 11H8.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        人間対応必要: {{HUMAN_REQUIRED_COUNT}}件
      </div>
    </div>
  </div>
</div>

</div><!-- /dash-container -->

<script>
  // Animate bars on load
  document.addEventListener('DOMContentLoaded', function() {
    var bars = document.querySelectorAll('.bar-fill');
    bars.forEach(function(bar) {
      var w = bar.style.width;
      bar.style.width = '0%';
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          bar.style.width = w;
        });
      });
    });
  });
</script>
</body>
</html>
